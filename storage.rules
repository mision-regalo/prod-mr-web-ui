rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /letters/{fileName} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
