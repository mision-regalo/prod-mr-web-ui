rules_version = '2';
service firebase.storage {
  match /b/gen-lang-client-0695399990-regalos/o {
    match /{allPaths=**} {
      // Secure bucket: access restricted to authenticated users
      allow read, write: if request.auth != null;
    }
  }
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
